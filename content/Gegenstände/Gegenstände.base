filters:
  and:
    - file.hasTag("gegenstand")
    - file.folder != "Templates"
formulas:
  preis_anzeige: if(preis % 1000 == 0, (preis / 1000) + " D", if(preis % 100 == 0, (preis / 100) + " S", if(preis % 10 == 0, (preis / 10) + " H", preis + " K")))
  preis_max_anzeige: if(preis_max % 1000 == 0, (preis_max / 1000) + " D", if(preis_max % 100 == 0, (preis_max / 100) + " S", if(preis_max % 10 == 0, (preis_max / 10) + " H", preis_max + " K")))
  Preis: if(preis_max.isEmpty() || preis_max == preis, formula.preis_anzeige, formula.preis_anzeige + " - " + formula.preis_max_anzeige)
  Kategorie: Kategorie.map(value.toString().replace(/^.*[|\/]|^\[\[|\]\]$/g, "")).join(", ")
  Materialkosten: if(preis % 1000 == 0, (preis / 1000) + " D", if(preis % 100 == 0, (preis / 100) + " S", if(preis % 10 == 0, (preis / 10) + " H", preis + " K")))
properties:
  note.preis:
    displayName: Preis in Kreuzern
  note.kategorie:
    displayName: Kategorie
  note.einheit:
    displayName: Preis pro
  file.name:
    displayName: Gegenstand
  note.aliases:
    displayName: Andere Namen
  note.aussehen:
    displayName: Aussehen
  note.herstellung_schwierigkeit:
    displayName: Probenschwierigkeit
  note.herstellung_material_verbreitung:
    displayName: Material Verbreitung
  note.haltbarkeit:
    displayName: Haltbarkeit
  note.herstellung_talent:
    displayName: Talent
  note.herstellung_werkzeug:
    displayName: Werkzeug
  note.preis_notiz:
    displayName: Anmerkung Preis
views:
  - type: table
    name: Standard
    groupBy:
      property: formula.Kategorie
      direction: ASC
    order:
      - file.name
      - formula.Preis
      - einheit
      - kategorie
      - preis
    sort:
      - property: preis
        direction: ASC
  - type: table
    name: Schmucksteine
    filters:
      and:
        - kategorie.contains(link("Schmucksteine"))
    order:
      - file.name
      - formula.Preis
      - aussehen
      - aliases
    sort:
      - property: file.name
        direction: ASC
      - property: preis
        direction: ASC
  - type: table
    name: Alchemika
    filters:
      and:
        - kategorie.contains(link("Gegenstände/Kategorien/Alchemika", "Alchemika"))
    order:
      - file.name
      - herstellung_talent
      - herstellung_schwierigkeit
      - herstellung_werkzeug
      - formula.Materialkosten
      - herstellung_material_verbreitung
      - haltbarkeit
  - type: table
    name: Alchimistische Stoffe
    filters:
      and:
        - kategorie.contains(link("Alchimistische Stoffe"))
    order:
      - file.name
      - formula.Preis
      - einheit
      - preis_notiz
      - aliases
      - preis
    columnSize:
      note.preis_notiz: 116
      note.aliases: 138
      note.preis: 119
